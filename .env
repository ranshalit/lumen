# =========================
# serial-console ENV FLAGS
# =========================

# ── Serial ports ──────────────────────────────────────────────────────────────

# SERIAL_BOOT_PORT — serial port connected to the bootloader console
# (EFI Shell, U-Boot, etc.).  The daemon will not start without this value.
# Check available ports with: ls /dev/tty{USB,ACM}* or dmesg | grep tty
SERIAL_BOOT_PORT=/dev/ttyUSB0

# SERIAL_LINUX_PORT — serial port connected to the Linux kernel console.
# Receives kernel boot messages and the login/shell prompt after boot.
# The daemon will not start without this value.
SERIAL_LINUX_PORT=/dev/ttyUSB0

# SERIAL_BAUD — baud rate for both serial ports.
# Must match the board's UART configuration.  115200 is standard for most boards.
SERIAL_BAUD=115200

# ── Credentials ───────────────────────────────────────────────────────────────

# SERIAL_USER — Linux username used for serial console login.
# The account must exist on the target and have passwordless-sudo or know the
# password set in SERIAL_PASS (the daemon injects it via stdin automatically).
SERIAL_USER=nexus

# SERIAL_PASS — Password for SERIAL_USER.
# Used in three places:
#   1. Sent to the serial login: prompt when auto-logging in.
#   2. Injected via stdin for sudo commands: echo 'PASS' | sudo -S <cmd>
#   3. Sent to sudo during serial-triggered reboot commands.
SERIAL_PASS=Pp12345678

# ── Timeouts (all values in seconds) ─────────────────────────────────────────

# SERIAL_TIMEOUT — default timeout applied to most CLI commands (detect-state,
# run-linux, run-bootloader, enter-bootloader, etc.) when --timeout is not explicitly passed.
SERIAL_TIMEOUT=30

# SERIAL_SILENCE_TIMEOUT — idle watchdog for run-linux --timeout 0 (wait-forever)
# calls.  If no output appears on the Linux serial port for this many seconds
# while waiting for a long-running command, the daemon treats the device as hung
# and triggers an automatic reboot before returning an error.
SERIAL_SILENCE_TIMEOUT=600

# SERIAL_TIMEOUT_ENTER_BOOTLOADER — how long enter-bootloader will keep hammering
# the bootloader entry key before giving up.  The boot menu is typically available
# for ~3 seconds after reset; this value just sets an upper bound on the retry loop.
SERIAL_TIMEOUT_ENTER_BOOTLOADER=30

# SERIAL_TIMEOUT_LINUX_LOGIN — maximum seconds linux-login will wait for the
# login: prompt after a reset, and then for the shell prompt after sending
# credentials.  Must comfortably cover a full Linux boot (kernel + systemd).
SERIAL_TIMEOUT_LINUX_LOGIN=90

# SERIAL_TIMEOUT_REBOOT — seconds the reboot command waits for shutdown activity
# (e.g. "reboot: Restarting system") on the serial port after issuing the reboot.
SERIAL_TIMEOUT_REBOOT=30

# ── Terminal geometry ─────────────────────────────────────────────────────────

# SERIAL_TERM_ROWS / SERIAL_TERM_COLS — terminal size reported back as an ANSI
# DSR response (\e[ROW;COLsR) to coax bash into emitting a fresh PS1 without
# blocking on a CPR query.  Adjust only if your PS1 misbehaves due to size.
SERIAL_TERM_ROWS=0
SERIAL_TERM_COLS=0

# ── Bootloader entry ─────────────────────────────────────────────────────────

# SERIAL_BOOTLOADER_ENTER_KEY — the character sent repeatedly on the bootloader
# serial port to stop the boot countdown and enter the bootloader shell.
# EFI/EDK2 (Intel, Jetson): 's'.  U-Boot (Xilinx, etc.): leave empty (sends \r).
# Some boards use 'escape' or 'f11'.
SERIAL_BOOTLOADER_ENTER_KEY=
SERIAL_BOOTLOADER_KEY_INTERVAL=0.1

# ── Detection patterns (Python regex, re.MULTILINE) ───────────────────────────

# SERIAL_BOOTLOADER_SHELL_PAT — Tegra210 U-Boot prompt
SERIAL_BOOTLOADER_SHELL_PAT='Tegra210.*#\s*$|Shell>'

# SERIAL_BOOTLOADER_MENU_PAT — U-Boot autoboot countdown
# NOTE: on this single-port board the probe sends \r\n on the boot port which
# can accidentally stop U-Boot autoboot.  We set a very specific pattern to
# avoid false positives, and rely on autoboot=0 (set via U-Boot env) to prevent
# interruption entirely.
SERIAL_BOOTLOADER_MENU_PAT='Loading kernel from LNX|Hit any key to stop autoboot'

# SERIAL_LINUX_LOGIN_PAT — matches the Linux login: prompt on the Linux port.
# When seen, the daemon transitions to state: linux-login.
SERIAL_LINUX_LOGIN_PAT=login:

# SERIAL_LINUX_SHELL_PAT — matches a logged-in bash/sh prompt on the Linux port.
# Default covers common shapes: "user@host:~$ ", "root@box:/# ", etc.
# When seen, the daemon transitions to state: linux-prompt.
SERIAL_LINUX_SHELL_PAT='(?:\w[\w.-]*@)?\S+:[^$#\n]*[$#]\s*$|sh-\d+\.\d+#\s*$'

# SERIAL_LINUX_BOOT_PAT — matches kernel/systemd boot messages on the Linux port.
# Used to detect that Linux is loading but has not yet reached the login prompt.
# When seen, the daemon transitions to state: linux-booting.
SERIAL_LINUX_BOOT_PAT='\[\s*\d+\.\d+\]|\bsystemd\[1\]\b|Reached target'

# SERIAL_LINUX_PASS_PAT — matches a "Password:" prompt during serial login.
# The daemon watches for this after sending the username to know when to send
# the password (SERIAL_PASS).
SERIAL_LINUX_PASS_PAT=[Pp]assword:\s*$

# SERIAL_REBOOT_PAT — matches any sign of an in-progress shutdown/reboot on the
# Linux port.  The reboot command waits for this pattern to confirm the reboot
# was accepted before returning ok=True.
SERIAL_REBOOT_PAT='reboot: Restarting system|INIT:.*runlevel: 6|Sending processes.*TERM|\[\d{4}\.\d{3}\] \[L4T|Reached target.*[Rr]eboot|Stopped.*[Ss]ession|systemd.*Starting Reboot|Unmounting|The system is going down'

# ── Daemon internals ──────────────────────────────────────────────────────────

# SERIAL_DAEMON_NAME — prefix for all daemon-managed files under /tmp:
#   /tmp/<NAME>.sock          Unix socket for client ↔ daemon communication
#   /tmp/<NAME>.pid           daemon PID file
#   /tmp/<NAME>.log           combined serial output (EFI + Linux), tail -f this
#   /tmp/<NAME>_internal.log  daemon diagnostic/debug log
# Change this if you run multiple daemon instances for different boards simultaneously.
SERIAL_DAEMON_NAME=serial

# SERIAL_RING_KB — per-port in-memory ring buffer size in kilobytes.
# The daemon keeps the most recent SERIAL_RING_KB × 1024 bytes from each port
# for pattern matching.  Increase if boot logs are large and patterns are missed
# because they scrolled out of the buffer before being checked.
SERIAL_RING_KB=64

# =========================
# ethernet-console ENV FLAGS
# =========================

# SSH not used for this board — serial console only.
# Uncomment and populate these if SSH access is ever needed:
DEVICE_IP=192.0.5.10
DEVICE_SSH_USER=nexus
DEVICE_SSH_PASS=Pp12345678
DEVICE_SSH_CONNECT_TIMEOUT=10

# DEVICE_CHUNK_MB — default chunk size (in MB) for chunked file transfers.
# Used by eth_transfer.py when --chunk-size is not passed explicitly.
DEVICE_CHUNK_MB=10

# =========================
# measure-boot.sh settings
# =========================

# Start marker — first meaningful bootloader line on Jetson Nano
BOOT_MEASURE_START_REGEX="Camera-FW on t234-rce-safe started"
BOOT_MEASURE_START_MARKER_NAME="Camera-FW (kernel +0.3s)"

# Fallback start marker — UEFI banner; appears later (post-OPTEE) but
# always plaintext on TCU console even with current capsule firmware.
BOOT_MEASURE_START_FALLBACK_REGEX="t23x_general UEFI firmware"
BOOT_MEASURE_START_FALLBACK_MARKER_NAME="t23x_general UEFI firmware"

# Ready marker — login banner means userspace is up
BOOT_MEASURE_READY_REGEX="lumen-orin-nx-16gb login:"

# Fallback: same as primary (don't fall back to "Poky" — the banner prints
# 2-3s BEFORE login: appears, which would under-report boot time by that
# much). Empty-string defaults in the skill fall through to "Poky|..." so
# we must set this to the same string as primary to disable fallback.
BOOT_MEASURE_READY_FALLBACK_REGEX="lumen-orin-nx-16gb login:"
BOOT_MEASURE_READY_FALLBACK_MARKER_NAME="lumen-orin-nx-16gb login:"

BOOT_MEASURE_SSH_PASSWORD=Pp12345678
BOOT_MEASURE_SSH_USER=nexus
MEASURE_BOOT_COLD_POWER_VALUE=12

# How long to keep ZUP off between off→on during a cold boot. 2s isn't
# enough on Orin Nano + carrier board — rail caps hold ~3-5s of charge and
# the SoC doesn't fully reset, so the run silently degrades into a warm
# restart that skips MB1/MB2 and reports ~5s "boot" instead of ~12s. 10s
# guarantees a true power-on reset.
BOOT_MEASURE_COLD_OFF_SECONDS=10

#TDK Lambda (Serial/USB mode — ZUP_HOST commented out to avoid TCP mode)
# NOTE: /dev/ttyUSB0 is the Jetson serial console (SERIAL_LINUX_PORT above).
# ZUP PSU is the FT232H USB-UART on /dev/ttyUSB1. Mixing them up makes
# `OUTP?` time out / return empty and the cold-boot path fails before
# powering the board on.
ZUP_PORT=/dev/ttyUSB1
ZUP_BAUDRATE=9600
ZUP_ADDRESS=6

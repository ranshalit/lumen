#!/bin/sh
### BEGIN INIT INFO
# Provides:          lumen-eth-static
# Required-Start:
# Required-Stop:
# Default-Start:
# Default-Stop:
# Short-Description: Configure static IP on eth0 (post-prompt, non-blocking)
### END INIT INFO
#
# Triggered via inittab `once` entry after getty spawns — runs concurrently
# with the login prompt so it never delays the boot path.
# lo (loopback) is handled automatically by the kernel; no ifup lo needed.

case "$1" in
    start)
        # Wait for eth0 link then bring it up — fully non-blocking from boot's POV
        (
            i=0
            while [ $i -lt 30 ] && \
                  [ "$(cat /sys/class/net/eth0/operstate 2>/dev/null)" != "up" ]; do
                sleep 1
                i=$((i+1))
            done
            ifup eth0
        ) &
        ;;
    stop)
        ifdown eth0 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

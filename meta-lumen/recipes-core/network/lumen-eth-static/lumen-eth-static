#!/bin/sh
### BEGIN INIT INFO
# Provides:          lumen-eth-static
# Required-Start:
# Required-Stop:
# Default-Start:
# Default-Stop:
# Short-Description: Configure static IP on eth0 (post-prompt, non-blocking)
### END INIT INFO
#
# Triggered via inittab `once` entry after getty spawns — runs concurrently
# with the login prompt so it never delays the boot path.
# lo (loopback) is handled automatically by the kernel; no ifup lo needed.
#
# IP and /etc/network/interfaces address are rendered from ETH_STATIC_IP in the recipe.

IFACE=eth0
IP=@ETH_STATIC_IP@
CIDR=24

case "$1" in
    start)
        # Fast link-up + static IP without ifup overhead.
        #
        # Why direct `ip` + `ethtool` instead of `ifup`:
        #   - busybox `ifup` adds ~1s of post-link-up busywork (operstate
        #     polling, route setup, etc.) on this device
        #   - ethtool tweaks fire WHILE the initial autoneg cycle is still in
        #     its FLP exchange phase; they abort it and restart with the
        #     correct (faster) configuration:
        #       * advertise=100baseT/Full only → skips 1000BASE-T training
        #         cycle (saves ~1s on Realtek r8168)
        #       * EEE off → skips Low-Power-Idle negotiation pages
        #       * flow-control pause off → one less negotiation page
        #
        # Measured win: ~0.4s mean (up to 1s) end-to-end boot-to-ping vs
        # `ifup eth0` with default 1G autoneg. See checkpoint
        # 001-instrumenting-lumen-boot-to-ping-timeline.
        #
        # NOTE: ethtool calls MUST fire AFTER `ip link set $IFACE up`.
        # Empirically, configuring the PHY while admin-down does NOT reliably
        # apply on the next link-up cycle — it regresses to default 1G
        # autoneg (~3.1s) instead of 100M-only (~2.1s).
        (
            # Wait for the interface to appear (driver probe via udev)
            i=0
            while [ $i -lt 100 ] && [ ! -e /sys/class/net/$IFACE ]; do
                sleep 0.05
                i=$((i+1))
            done

            ip link set $IFACE up
            ethtool --set-eee $IFACE eee off 2>/dev/null
            ethtool -A $IFACE autoneg off rx off tx off 2>/dev/null
            ethtool -s $IFACE advertise 0x008 2>/dev/null

            # Wait for link partner (carrier=1) then assign the static IP.
            # Bounded to ~10s (200 * 0.05s): 100M-only autoneg settles in
            # ~2-2.6s on the r8168, so this never trips on the normal path and
            # adds zero boot-to-ping time. On a missing/late link it stops the
            # 20Hz busy-poll and assigns the IP anyway, so a cable plugged in
            # later still works.
            i=0
            while [ "$(cat /sys/class/net/$IFACE/carrier 2>/dev/null)" != "1" ] && [ $i -lt 200 ]; do
                sleep 0.05
                i=$((i+1))
            done

            ip addr add $IP/$CIDR dev $IFACE 2>/dev/null || true
        ) &

        (
            i=0
            while [ "$i" -lt 100 ] && [ ! -e /sys/class/net/portus0 ]; do
                sleep 0.05
                i=$((i + 1))
            done

            if [ ! -e /sys/class/net/portus0 ]; then
                echo "lumen-eth-static: portus0 did not appear" >&2
                exit 1
            fi

            if ! ip link set portus0 up; then
                echo "lumen-eth-static: failed to bring up portus0" >&2
                exit 1
            fi

            if ! ip addr replace @PORTUS_STATIC_IP@/24 dev portus0; then
                echo "lumen-eth-static: failed to assign address to portus0" >&2
                exit 1
            fi
        ) &
        ;;
    stop)
        ip link set $IFACE down 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

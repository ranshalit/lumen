#!/bin/sh
### BEGIN INIT INFO
# Provides:          lumen-eth-static
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     S
# Default-Stop:
# Short-Description: Configure static IP on eth0 (non-blocking)
### END INIT INFO

case "$1" in
    start)
        # Bring up loopback synchronously (needed before login prompt)
        ifup lo 2>/dev/null || true

        # Bring up eth0 in the background — waits for link without blocking boot
        (
            i=0
            while [ $i -lt 30 ] && \
                  [ "$(cat /sys/class/net/eth0/operstate 2>/dev/null)" != "up" ]; do
                sleep 1
                i=$((i+1))
            done
            ifup eth0
        ) &
        ;;
    stop)
        ifdown eth0 2>/dev/null || true
        ifdown lo 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

#!/bin/sh
### BEGIN INIT INFO
# Provides:          lumen-eth-static
# Required-Start:
# Required-Stop:
# Default-Start:
# Default-Stop:
# Short-Description: Configure static IP on eth0 (post-prompt, non-blocking)
### END INIT INFO
#
# Triggered via inittab `once` entry after getty spawns — runs concurrently
# with the login prompt so it never delays the boot path.
# lo (loopback) is handled automatically by the kernel; no ifup lo needed.

case "$1" in
    start)
        # Bring eth0 up as early as possible — fully non-blocking from boot's
        # POV. The link autonegotiates (gigabit) once the interface is opened.
        #
        # NOTE: the interface MUST be brought up before the link can come up.
        # r8168 only powers the PHY and negotiates a link once the netdev is
        # opened (ifup), so we ifup immediately instead of waiting for the link
        # first — waiting on operstate before ifup just burns ~30s every boot.
        (
            # Wait for the eth0 interface to appear (driver probe)
            i=0
            while [ $i -lt 10 ] && [ ! -e /sys/class/net/eth0 ]; do
                sleep 1
                i=$((i+1))
            done

            # Open the interface and assign the static IP right away — this is
            # what powers the PHY and starts link negotiation.
            ifup eth0
        ) &
        ;;
    stop)
        ifdown eth0 2>/dev/null || true
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac

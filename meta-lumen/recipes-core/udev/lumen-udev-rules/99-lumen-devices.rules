# Udev symlink rules for application serial/camera devices.
#
# After updating, rebuild the image or reload on the board:
#   udevadm control --reload-rules && udevadm trigger

# Pixhawk autopilot — two possible USB adapters
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="2303", SYMLINK+="ttyPixhawk", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="ttyPixhawk", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", SYMLINK+="ttyPixhawk", MODE="0666"

# Teensy microcontroller — on-board UART (3100000.serial)
SUBSYSTEM=="tty", KERNELS=="3100000.serial", SYMLINK+="ttyTeensy", MODE="0666"

# Hodakev device — on-board UART (3110000.serial)
SUBSYSTEM=="tty", KERNELS=="3110000.serial", SYMLINK+="ttyHodakev", MODE="0666"

# Camera serial interface — USB serial (Cypress VID:PID 04b4:7510)
SUBSYSTEM=="tty", ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="7510", SYMLINK+="ttyCameraSerial", MODE="0666"

# Portus expansion card — Microchip LAN7430 Gigabit Ethernet (PCIe, lan743x).
# Give only the Portus NIC an explicit name; the onboard r8168 keeps eth0 by
# the kernel default. Do NOT add a NAME= rule for the onboard NIC: renaming an
# interface the r8168 driver is already bringing up forces udev to re-do the
# link bring-up on the add event, racing PHY autonegotiation and delaying
# "eth0: link up" from ~8s to ~150s (boot-to-ping regression).
SUBSYSTEM=="net", ACTION=="add", DRIVERS=="lan743x", NAME="portus0"

# usb2-0 dual-role port host-mode switch is NOT done here.
#
# A `SUBSYSTEM=="usb_role", ATTR{role}="host"` rule looks harmless but is a
# boot-killer: during coldplug (`udevadm trigger --action=add` in the S04udev
# init script) the udev worker performs the `role` attribute write itself, and
# on tegra that sysfs write blocks in the padctl role-switch driver until the
# controller/PHY is ready. The worker never finishes, so the following
# `udevadm settle` (no timeout, S04udev line 106) waits its full 120s default
# before rcS continues — freezing the ENTIRE boot for ~120s with zero kernel
# log output (boot-to-ping regressed from ~8s to ~130s).
#
# The role switch is now handled by the backgrounded rcS init script
# lumen-usb2-host (recipe lumen-usb2-host.bb), which writes "host" from a
# detached subshell so it can never block boot regardless of controller state.

#!/bin/sh
### BEGIN INIT INFO
# Provides:          lumen-usb-otg
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     S
# Default-Stop:
# Short-Description: Set USB2-0 OTG role to device mode (Aerium Lumen)
### END INIT INFO

ROLE_NODE=/sys/class/usb_role/usb2-0-role-switch/role

case "$1" in
    start)
        echo "device" > "$ROLE_NODE"
        ;;
    stop)
        echo "host" > "$ROLE_NODE"
        ;;
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac
